{
  "name": "marathon-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Telegram-бот марафона «Контент-завод»",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "railway": "npm run build && npm start",
    "admin": "tsx admin/server.ts",
    "admin:dev": "tsx watch admin/server.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@grammyjs/conversations": "^2.0.3",
    "@grammyjs/runner": "^2.0.3",
    "@supabase/supabase-js": "^2.49.1",
    "@types/node": "^22.13.10",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "grammy": "^1.35.0",
    "multer": "^2.2.0",
    "typescript": "^5.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "tsx": "^4.19.3"
  }
}

